[%General]
bold_active_tab=true
active_tab_overlap=2
joined_inactive_tabs=false
author=Leonardo Borges
comment=Windows 98 (feito à mão)
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=true
mirror_doc_tabs=true
group_toolbar_buttons=false
spread_progressbar=true
composite=false
menu_shadow_depth=0
tooltip_shadow_depth=0
splitter_width=4
scroll_width=17
scroll_arrows=true
scrollbar_in_view=false
transient_scrollbar=false
transient_groove=false
slider_width=4
slider_handle_width=22
slider_handle_length=11
center_toolbar_handle=true
check_size=13
textless_progressbar=false
progressbar_thickness=18
menubar_mouse_tracking=true
toolbutton_style=0
double_click=false
translucent_windows=false
blurring=false
popup_blurring=false
vertical_spin_indicators=true
spin_button_width=17
fill_rubberband=false
merge_menubar_with_toolbar=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16
combo_as_lineedit=false
animate_states=false
combo_menu=false
tooltip_shadow_depth=0
menu_blur_radius=0
contrast=1.0
saturation=1.0
lightness=1.0
reduce_menu_opacity=0
submenu_overlap=0

[GeneralColors]
window.color=#c0c0c0
base.color=#ffffff
alt.base.color=#e8e8e8
button.color=#c0c0c0
light.color=#ffffff
mid.light.color=#dfdfdf
dark.color=#808080
mid.color=#a0a0a0
highlight.color=#000080
inactive.highlight.color=#000080
text.color=#000000
window.text.color=#000000
button.text.color=#000000
disabled.text.color=#808080
tooltip.text.color=#000000
highlight.text.color=#ffffff
link.color=#0000ff
link.visited.color=#800080
progress.indicator.text.color=#ffffff

[Hacks]
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=false
blur_translucent=false
transparent_menutitle=false
respect_darkness=false
kcapacitybar_as_progressbar=true
force_size_grip=true
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=100
normal_default_pushbutton=true
single_top_toolbar=false
tint_on_mouseover=0
no_selection_tint=true
transparent_ktitle_label=false
transparent_menubar=false
menubar_as_tabbar=false
opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,dragonplayer,digikam

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.expansion=0
interior=true
interior.element=button
indicator.element=arrow
indicator.size=9
text.shadow=0
text.margin.top=1
text.margin.bottom=1
text.margin.left=3
text.margin.right=3
text.iconspacing=4
min_width=+0.0font
min_height=+0.3font

[PanelButtonTool]
inherits=PanelButtonCommand
frame.expansion=0

[Dock]
inherits=PanelButtonCommand

[DockTitle]
frame=false
interior=false
text.bold=true

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[Indicator]
indicator.element=arrow
indicator.size=9

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=tab
indicator.size=14
frame.top=4
frame.bottom=2
frame.left=2
frame.right=2
frame.expansion=0
text.margin.top=1
text.margin.bottom=1
text.margin.left=6
text.margin.right=6

[TabFrame]
frame=true
frame.element=tabframe
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=true
interior.element=window

[TreeExpander]
indicator.element=arrow
indicator.size=9

[GroupBox]
frame=true
frame.element=groove
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=false
text.bold=false
text.margin.top=0
text.margin.bottom=0

[LineEdit]
frame=true
frame.element=field
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=true
interior.element=field
text.margin.top=1
text.margin.bottom=1
text.margin.left=2
text.margin.right=2

[IndicatorSpinBox]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=9

[SpinBox]
inherits=LineEdit

[ComboBox]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=9
text.margin.left=3
text.margin.right=3

[ComboLineEdit]
inherits=LineEdit

[MenuBar]
frame=false
interior=true
interior.element=window
text.margin.top=0
text.margin.bottom=0

[MenuBarItem]
frame=false
interior=true
interior.element=menubaritem
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6
text.normal.color=#000000
text.focus.color=#ffffff

[Menu]
frame=true
frame.element=menu
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=true
interior.element=menu
text.shadow=0

[MenuItem]
frame=false
interior=true
interior.element=menuitem
indicator.element=arrow
indicator.size=9
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=8
text.normal.color=#000000
text.focus.color=#ffffff

[ToolTip]
frame=true
frame.element=tooltip
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
interior=true
interior.element=tooltip
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3

[Splitter]
frame=false
interior=false
indicator.element=arrow

[Scrollbar]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=9

[ScrollbarGroove]
frame=false
interior=true
interior.element=groove

[ScrollbarSlider]
frame=true
frame.element=button
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=true
interior.element=button
min_width=1.0font
min_height=1.0font

[Slider]
frame=true
frame.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=true
interior.element=slider

[SliderCursor]
frame=true
frame.element=button
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=true
interior.element=button

[Progressbar]
frame=true
frame.element=groove
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=true
interior.element=groove
text.margin.top=0
text.margin.bottom=0
text.color=#000000

[ProgressbarContents]
frame=false
interior=true
interior.element=progress
text.color=#ffffff

[ItemView]
frame=true
frame.element=itemview
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=true
interior.element=itemview

[HeaderSection]
inherits=PanelButtonCommand
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[SizeGrip]
frame=false
interior=false

[Toolbar]
frame=false
interior=true
interior.element=window

[ToolbarHandle]
frame=false
interior=false

[Window]
frame=false
interior=true
interior.element=window

[CheckBox]
frame=false
interior=true
interior.element=checkbox

[RadioButton]
frame=false
interior=true
interior.element=radio

[Focus]
frame=false
interior=false

[GenericFrame]
frame=true
frame.element=field
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=false

[TabBarFrame]
frame=false
interior=false

[PanelButtonPanel]
inherits=PanelButtonCommand
